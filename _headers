# Cloudflare Workers static-assets headers.
#
# This site is served by Cloudflare (wrangler.jsonc, "assets": {"directory": "./"}),
# NOT by the nginx config in deploy/ — see DEPLOYMENT.md.
#
# Why this file exists: devinfo.json and the toolbox XML are fetched by
# XMLHttpRequest from ui/core/ui.js, not by <script>/<link> tags. They were the
# only assets requested without a `?ver=` cache-buster, so browsers were free to
# apply heuristic freshness and keep serving an old copy from disk without ever
# revalidating. index.html, being a navigation request, kept revalidating
# normally — so a fresh index.html could pair with a months-old devinfo.json and
# offer a board the JSON did not define, which surfaced as "Invalid device."
#
# no-store (not no-cache) because these files decide which pins the blocks offer.
# A wrong pin list is a bricked board, not a cosmetic glitch, so it is worth
# paying a small request on every load to never serve a stale one.

/ui/devinfo/*
  Cache-Control: no-store

/ui/toolbox/*
  Cache-Control: no-store

# core/queue.js is the same hazard wearing different clothes. It began as a
# localStorage helper, but now also defines the VL53L0X and classroom I2C
# blocks and injects their toolbox category at runtime, so a stale copy means
# blocks that quietly do not exist. It is the one file under core/ whose
# staleness removes functionality rather than just ageing it, hence a rule
# here as well as the ?ver= in index.html: the query string covers deploys
# where index.html is fresh, this covers the rest.
#
# no-cache rather than the no-store used above: this one is a script, not a
# pin list. Revalidating gives a 304 and no body on the common path, which
# matters for a classroom sharing one connection, and a wrong answer here
# costs missing blocks rather than a bricked board.

/ui/core/queue.js
  Cache-Control: no-cache

# core/gyro_blocks.js is the same case as queue.js above: it defines the
# gyro_setup / gyro_reset / gyro_turn blocks and generators, so a stale copy
# means those blocks silently do not exist. Its toolbox entry is a static
# category in esp32.xml (covered by the no-store rule above), not a runtime
# injection, so this file only needs to stay in step with itself.

/ui/core/gyro_blocks.js
  Cache-Control: no-cache
